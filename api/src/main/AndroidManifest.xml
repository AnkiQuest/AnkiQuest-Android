<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
    One <uses-permission> and one <queries> entry per provider in KnownProviders.
    Android merges them into every client app, so clients need no manifest changes.
    KnownProvidersManifestTest checks that this file matches the list.
    -->

    <!-- AnkiDroid -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE"/>
    <!-- AnkiQuest -->
    <uses-permission android:name="org.ankiquest.anki.permission.READ_WRITE_DATABASE"/>
    <!-- AnkiQuest up to quest-23 -->
    <uses-permission android:name="com.ichi2.anki.quest.permission.READ_WRITE_DATABASE"/>

    <queries>
        <!-- AnkiDroid -->
        <package android:name="com.ichi2.anki" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <!-- AnkiQuest -->
        <package android:name="org.ankiquest.anki" />
        <provider android:authorities="org.ankiquest.anki.flashcards" />
        <!-- AnkiQuest up to quest-23 -->
        <package android:name="com.ichi2.anki.quest" />
        <provider android:authorities="com.ichi2.anki.quest.flashcards" />
        <!-- Lets AddContentApi.getProviders see AnkiDroid builds and forks on Android 11+ -->
        <intent>
            <action android:name="com.ichi2.anki.action.FLASHCARDS_PROVIDER" />
        </intent>
    </queries>

    <application android:allowBackup="true" android:label="@string/app_name">
        <!-- Lets the user pick one of the installed providers, see AddContentApi.chooseProvider -->
        <activity
            android:name="com.ichi2.anki.api.ProviderChooserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
