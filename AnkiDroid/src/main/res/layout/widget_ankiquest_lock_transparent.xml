<!-- The transparent leaderboard widget's last list item while the server leaves other players out. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ankiquest_widget_lock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp"
    android:shadowColor="#B3000000"
    android:shadowDy="1"
    android:shadowRadius="3"
    android:textColor="@color/ankiquest_widget_clear_text"
    android:textSize="13sp" />
