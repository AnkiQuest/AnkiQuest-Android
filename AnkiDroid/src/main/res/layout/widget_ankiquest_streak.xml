<!-- 2x2: the companion beside the number and its meters, over the status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ankiquest_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ankiquest_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingTop="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="8dp">

    <!-- The number keeps the width its digits and flame need; the companion gives way on narrow widgets.
         The narrow side padding fits a 49 dp companion beside two digits at 100 dp; the status keeps 8 dp. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ankiquest_streak_companion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="@dimen/ankiquest_streak_companion_medium"
            android:maxHeight="@dimen/ankiquest_streak_companion_medium"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ankiquest_streak_number"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="@dimen/ankiquest_streak_number_medium"
                android:textColor="@color/ankiquest_widget_text"
                android:textSize="20sp"
                tools:targetApi="o" />

            <FrameLayout
                android:id="@+id/ankiquest_streak_meter"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/ankiquest_streak_goal"
                style="@style/AnkiquestStreakProgress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="1dp"
                android:progressDrawable="@drawable/ankiquest_streak_widget_meter"
                android:progressTint="@color/ankiquest_streak_warm"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- The status and the number say the streak; the 2x2 card has no room for this label. -->
    <TextView
        android:id="@+id/ankiquest_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ankiquest_streak_status"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:textColor="@color/ankiquest_widget_text_dim"
        android:textSize="11sp"
        tools:targetApi="o" />
</LinearLayout>
